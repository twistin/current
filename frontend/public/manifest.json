{
  "manifest_version": 3,
  "name": "Current // Escudo Táctico",
  "version": "1.0.0",
  "description": "Radar de inteligencia ciudadana y auditoría de actores desinformadores en redes sociales.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Current // Escudo Táctico Activo"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://current-app-qg6pp.ondigitalocean.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
